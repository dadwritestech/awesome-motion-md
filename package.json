{
  "name": "awesome-motion-md",
  "version": "0.1.0",
  "private": true,
  "description": "Measured MOTION.md files for coding agents, an extractor that measures any site's motion, and a linter for AI motion tells.",
  "license": "MIT",
  "bin": {
    "motionlint": "lint/motionlint.mjs"
  },
  "scripts": {
    "test": "node --test lint/motionlint.test.mjs",
    "lint:motion": "node lint/motionlint.mjs",
    "extract": "node extract/extract.mjs",
    "summarize": "node extract/summarize.mjs",
    "draft": "node extract/generate.mjs",
    "demo": "node demo/record.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
